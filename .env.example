# NextAuth
NEXTAUTH_SECRET=replace-with-random-32-bytes
NEXTAUTH_URL=http://localhost:3000

# Credentials auth (single admin)
AUTH_USERNAME=admin
# Generate with: node -e "console.log(require('bcrypt').hashSync(process.argv[1], 10))" your-password
AUTH_PASSWORD_HASH=$2b$10$exampleReplaceMeWithRealHashxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gallery builder
GALLERY_SRC=./NAS/albums
GALLERY_OUT=./public/photos

